# Copiá este archivo como .env y completalo. El .env NO se sube a GitHub.
MOODLE_USER=tu_usuario_o_dni
MOODLE_PASS=tu_contraseña
# Opcional: dirección del aula, si el login no está en el mismo sitio que los links
# (por defecto se deduce del link que pegás, ej. https://campus.udelaciudad.edu.ar)
# MOODLE_URL=https://campus.udelaciudad.edu.ar
# Opcional: puerto de la interfaz web
# PUERTO=5056
